# .env.example

# Required
GITHUB_TOKEN=ghp_xxx_your_token_here         # PAT with repo write/pull permissions
PUSH_API_KEY=pick-a-strong-secret            # Server-side secret; do NOT hard-code in client

# CORS / Origins (comma-separated). Example:
ALLOWED_ORIGINS=http://localhost:8080,https://your.production.domain
# Opt-in wildcard (NOT recommended for production):
ALLOW_ORIGIN_WILDCARD=0

# Limits and logging
MAX_REQUEST_BODY_BYTES=200000
RATE_LIMIT_PER_MIN=60
LOG_FILE=logs/github_push_service.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# Optional: remote log forwarder (HTTP endpoint)
# LOG_FORWARD_URL=https://logs.example.com/ingest
